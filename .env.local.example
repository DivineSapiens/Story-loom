# Copy this file to .env.local and fill in your real values.
# These are only ever read server-side (API routes) — never exposed to the browser.

# ── PRIMARY: watsonx / IBM Granite ───────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-iam-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── IMAGE GENERATION: Hugging Face Inference API ──────────────────────────────
# Get your free token at: https://huggingface.co/settings/tokens
# Permission needed: "Make calls to serverless Inference API" (read scope)
HUGGINGFACE_TOKEN=hf_your_token_here

# ── FALLBACK: Groq (llama-3.3-70b-versatile) ────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
