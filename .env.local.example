# Copy this file to .env.local and fill in your real values.
# These are only ever read server-side (API routes) — never exposed to the browser.

# ── Required for real AI (without these, the app falls back to stub demo data) ──
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ── Optional ──────────────────────────────────────────────────────────────────
# Region for the watsonx service URL (default: us-south).
# Other values: eu-de, eu-gb, jp-tok, au-syd
WATSONX_REGION=us-south

# Override the default model (default: ibm/granite-3-8b-instruct).
# Other options: ibm/granite-3-2b-instruct, ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
